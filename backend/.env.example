FRONTEND_URL=https://wbs.itfuturz.in
WEBHOOK_URL=https://wbs.itfuturz.in/webhook
NODE_ENV=production

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/wbs_platform

# Security & Encryption
